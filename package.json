{
  "name": "zoomer",
  "displayName": "Zoomer",
  "description": "Finely tune your zoom levels to get the perfectly sized text",
  "version": "0.3.5",
  "publisher": "anthonyattard",
  "engines": {
    "vscode": "^1.75.0"
  },
  "keywords": [
    "zoom",
    "text size",
    "font",
    "productivity"
  ],
  "categories": [
    "Linters",
    "Formatters",
    "Other"
  ],
  "license": "MIT",
  "homepage": "https://github.com/anthonyattard/zoomer",
  "bugs": {
    "url": "https://github.com/anthonyattard/zoomer/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anthonyattard/zoomer"
  },
  "main": "./out/extension.js",
  "qna": "https://github.com/anthonyattard/zoomer/discussions/categories/q-a",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "icon": "img/icon.png",
  "galleryBanner": {
    "color": "#C80000",
    "theme": "dark"
  },
  "contributes": {
    "commands": [
      {
        "command": "zoomer.zoomIns",
        "title": "zoomer.zoomIns"
      },
      {
        "command": "zoomer.zoomOuts",
        "title": "zoomer.zoomOuts"
      },
      {
        "command": "zoomer.zoomReset",
        "title": "zoomer.zoomReset"
      }
    ],
    "keybindings": [
      {
        "command": "zoomer.zoomIns",
        "key": "ctrl+=",
        "mac": "cmd+="
      },
      {
        "command": "zoomer.zoomIns",
        "key": "ctrl+numpad_add",
        "mac": "cmd+numpad_add"
      },
      {
        "command": "zoomer.zoomOuts",
        "key": "ctrl+-",
        "mac": "cmd+-"
      },
      {
        "command": "zoomer.zoomOuts",
        "key": "ctrl+numpad_subtract",
        "mac": "cmd+numpad_subtract"
      },
      {
        "command": "zoomer.zoomReset",
        "key": "ctrl+0",
        "mac": "cmd+0"
      },
      {
        "command": "zoomer.zoomReset",
        "key": "ctrl+numpad0",
        "mac": "cmd+numpad0"
      }
    ],
    "configuration": {
      "properties": {
        "zoomer.zoomIncrement": {
          "type": "number",
          "default": 0.1,
          "description": "Zoom level value when incrementing/decrementing (can accept decimals)"
        }
      },
      "title": "Zoomer Zoom Settings"
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run esbuild-base --minify",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "test-compile": "tsc -p ./",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "esbuild": "pnpm run esbuild-base --sourcemap",
    "esbuild-watch": "pnpm run esbuild-base --sourcemap --watch"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.4",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "glob": "^13.0.6",
    "mocha": "^12.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
